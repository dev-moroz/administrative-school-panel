# Шаблон для apps/api/.env (cp env/api.env.example apps/api/.env). Не коммитить сам .env.
# Должен совпадать с POSTGRES_* из корневого .env.
DATABASE_URL=postgresql://school:school@localhost:5432/school?schema=public
PORT=4000
# ЗАМЕНИТЬ до этапа 1 на длинные случайные строки: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=school@example.com
