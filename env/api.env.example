# Template for apps/api/.env (cp env/api.env.example apps/api/.env). Do not commit the real .env.
# Must match POSTGRES_* in the root .env.
DATABASE_URL=postgresql://school:school@localhost:5432/school?schema=public
PORT=4000
# Origins allowed to send mutating requests (comma-separated).
WEB_ORIGIN=http://localhost:3000
# REPLACE before stage 1 with long random strings: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
# Path of the refresh cookie as the browser sees it: /api/auth behind the Next proxy, /auth when calling Nest directly.
REFRESH_COOKIE_PATH=/api/auth

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=school@example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_to_pass

# Temporary (deprecated once the Users module exists): seeds the first teacher. Leave empty to skip.
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_NAME=

# Payment proof files are stored here (gitignored). In production mount a Docker volume on this path.
UPLOADS_DIR=./uploads
