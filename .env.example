# The root .env is read ONLY by Docker Compose. Copy it: cp .env.example .env
POSTGRES_USER=school
POSTGRES_PASSWORD=school
POSTGRES_DB=school

# Production only (docker-compose.prod.yml); the dev compose ignores these.
# Use a strong POSTGRES_PASSWORD above in production.
# Public URL of the site (comma-separated if several).
WEB_ORIGIN=http://localhost:3000
# Long random string: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_to_pass
# Optional: seeds the first teacher. Leave empty to skip.
# Required for docker-compose.demo.yml: this is the public demo account, its password is shown on the login page.
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_NAME=
