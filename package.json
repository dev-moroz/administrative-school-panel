{
  "name": "english-school-admin",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm infra:up && concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
