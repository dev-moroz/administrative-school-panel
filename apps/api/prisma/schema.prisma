generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  passwordHash        String               @map("password_hash")
  firstName           String?              @map("first_name")
  lastName            String?              @map("last_name")
  locale              String               @default("en")
  isActive            Boolean              @default(true) @map("is_active")
  role                Role                 @relation(fields: [roleId], references: [id])
  roleId              String               @map("role_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  passwordResetTokens PasswordResetToken[]
  teacher             Teacher?
  student             Student?
  ledgerEntries       LedgerEntry[]
  payments            Payment[]
  paymentProofFiles   PaymentProofFile[]
  absences            Absence[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  isSystem        Boolean          @default(false) @map("is_system")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

enum EnglishLevel {
  A0
  A1
  A2
  B1
  B2
  C1
  C2
}

model Currency {
  code     String    @id
  name     String
  decimals Int       @default(2)
  isActive Boolean   @default(true) @map("is_active")
  students Student[]
  payments Payment[]

  @@map("currencies")
}

model Teacher {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String           @map("full_name")
  timeZone       String           @default("Europe/Moscow") @map("time_zone")
  telegramChatId BigInt?          @unique @map("telegram_chat_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  students       StudentTeacher[]
  lessons        Lesson[]
  lessonSeries   LessonSeries[]
  absences       Absence[]

  @@map("teachers")
}

model Student {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String?          @unique @map("user_id") @db.Uuid
  user                     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName                 String           @map("full_name")
  telegramUsername         String?          @map("telegram_username")
  telegramChatId           BigInt?          @unique @map("telegram_chat_id")
  englishLevel             EnglishLevel?    @map("english_level")
  comment                  String?
  defaultCurrency          Currency?        @relation(fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  defaultCurrencyCode      String?          @map("default_currency_code")
  defaultPaymentMethod     PaymentMethod?   @relation(fields: [defaultPaymentMethodCode], references: [code], onDelete: Restrict)
  defaultPaymentMethodCode String?          @map("default_payment_method_code")
  lessonPrice              Decimal?         @map("lesson_price") @db.Decimal(12, 2)
  isActive                 Boolean          @default(true) @map("is_active")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  teachers                 StudentTeacher[]
  ledgerEntries            LedgerEntry[]
  payments                 Payment[]
  lessons                  LessonParticipant[]
  lessonSeries             LessonSeries[]
  absences                 Absence[]

  @@index([fullName])
  @@index([defaultCurrencyCode])
  @@index([defaultPaymentMethodCode])
  @@map("students")
}

model StudentTeacher {
  studentId String   @map("student_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@id([studentId, teacherId])
  @@index([teacherId])
  @@map("student_teachers")
}

enum LedgerEntryType {
  PURCHASE
  LESSON_CHARGE
  LESSON_REVERSAL
  MANUAL_ADJUSTMENT
}

model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  studentId   String          @map("student_id") @db.Uuid
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  delta       Int
  type        LedgerEntryType
  comment     String?
  // null = System (automatic charge).
  createdById String?         @map("created_by_id") @db.Uuid
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  paymentId   String?         @unique @map("payment_id") @db.Uuid
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  lessonId    String?         @map("lesson_id") @db.Uuid
  // SetNull: deleting a lesson whose entries sum to 0 keeps the entries.
  lesson      Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([studentId, createdAt])
  @@index([lessonId])
  @@map("ledger_entries")
}

model PaymentMethod {
  code      String    @id
  name      String
  icon      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  payments  Payment[]
  students  Student[]

  @@map("payment_methods")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(28, 8)
  currencyCode   String        @map("currency_code")
  currency       Currency      @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  paidAt         DateTime      @map("paid_at")
  methodCode     String        @map("method_code")
  method         PaymentMethod @relation(fields: [methodCode], references: [code], onDelete: Restrict)
  comment        String?
  proofUrl       String?       @map("proof_url")
  lessonsGranted Int           @map("lessons_granted")
  createdById    String        @map("created_by_id") @db.Uuid
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @map("created_at")
  ledgerEntry    LedgerEntry?
  proofFile      PaymentProofFile?

  @@index([studentId, paidAt])
  @@index([paidAt])
  @@map("payments")
}

model PaymentProofFile {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @unique @map("payment_id") @db.Uuid
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("payment_proof_files")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model CancelReason {
  code     String   @id
  name     String
  isActive Boolean  @default(true) @map("is_active")
  lessons  Lesson[]

  @@map("cancel_reasons")
}

model Lesson {
  id               String              @id @default(uuid()) @db.Uuid
  teacherId        String              @map("teacher_id") @db.Uuid
  teacher          Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  startsAt         DateTime            @map("starts_at")
  durationMin      Int                 @map("duration_min")
  status           LessonStatus        @default(SCHEDULED)
  charged          Boolean             @default(false)
  cancelledAt      DateTime?           @map("cancelled_at")
  cancelReasonCode String?             @map("cancel_reason_code")
  cancelReason     CancelReason?       @relation(fields: [cancelReasonCode], references: [code], onDelete: Restrict)
  comment          String?
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  participants     LessonParticipant[]
  ledgerEntries    LedgerEntry[]
  seriesId         String?             @map("series_id") @db.Uuid
  series           LessonSeries?       @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  originalDate     DateTime?           @map("original_date") @db.Date
  manuallyChanged  Boolean             @default(false) @map("manually_changed")
  absenceId        String?             @map("absence_id") @db.Uuid
  absence          Absence?            @relation(fields: [absenceId], references: [id], onDelete: SetNull)

  @@unique([seriesId, originalDate])
  @@index([teacherId, startsAt])
  @@index([status, startsAt])
  @@index([cancelReasonCode])
  @@index([absenceId])
  @@map("lessons")
}

model LessonSeries {
  id             String    @id @default(uuid()) @db.Uuid
  teacherId      String    @map("teacher_id") @db.Uuid
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  studentId      String    @map("student_id") @db.Uuid
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  weekday        Int
  startTime      String    @map("start_time")
  durationMin    Int       @map("duration_min")
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  generatedUntil DateTime? @map("generated_until") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lessons        Lesson[]
  skips          SeriesSkip[]

  @@index([studentId])
  @@index([teacherId])
  @@map("lesson_series")
}

// A series slot the generator decided not to create; it is never retried.
model SeriesSkip {
  seriesId         String       @map("series_id") @db.Uuid
  series           LessonSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  originalDate     DateTime     @map("original_date") @db.Date
  reason           String
  conflictLessonId String?      @map("conflict_lesson_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")

  @@id([seriesId, originalDate])
  @@map("series_skips")
}

model LessonParticipant {
  lessonId  String  @map("lesson_id") @db.Uuid
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([lessonId, studentId])
  @@index([studentId])
  @@map("lesson_participants")
}

enum AbsenceKind {
  STUDENT_FREEZE
  TEACHER_VACATION
}

// Single row (id = 1), inserted by the migration.
model SchoolSettings {
  id                  Int      @id @default(1)
  lowBalanceThreshold Int      @default(2) @map("low_balance_threshold")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("school_settings")
}

// Whole Moscow days, both ends inclusive; exactly one owner (DB check).
model Absence {
  id          String      @id @default(uuid()) @db.Uuid
  kind        AbsenceKind
  studentId   String?     @map("student_id") @db.Uuid
  student     Student?    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacherId   String?     @map("teacher_id") @db.Uuid
  teacher     Teacher?    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  startsOn    DateTime    @map("starts_on") @db.Date
  endsOn      DateTime    @map("ends_on") @db.Date
  comment     String?
  createdById String      @map("created_by_id") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  lessons     Lesson[]

  @@index([studentId, startsOn])
  @@index([teacherId, startsOn])
  @@map("absences")
}
